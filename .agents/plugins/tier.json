{
  "schema_version": 1,
  "tier": "react",
  "stack": "TypeScript/React",
  "applies": "stack-present",
  "owner_repository": [
    "tj-agents/react",
    "tomjseery/react-agents"
  ],
  "detect": {
    "files": [
      "tsconfig.json"
    ],
    "globs": [
      "*.tsx",
      "*.ts",
      "*.jsx"
    ],
    "content": [
      {
        "glob": "package.json",
        "pattern": "\"(react|react-dom|typescript)\"\\s*:"
      }
    ]
  }
}
