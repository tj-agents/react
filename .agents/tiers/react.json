{
  "schema_version": 1,
  "tier": "react",
  "stack": "TypeScript/React",
  "applies": "stack-present",
  "owner_repository": [
    "tj-agents/react"
  ],
  "detect": {
    "files": [
      "tsconfig.json"
    ],
    "globs": [
      "*.tsx",
      "*.ts",
      "*.jsx"
    ],
    "content": [
      {
        "glob": "package.json",
        "pattern": "\"(react|react-dom|typescript)\"\\s*:"
      }
    ]
  },
  "routes": [
    {
      "path": "(^|/)package\\.json$",
      "skills": [
        "react:libraries"
      ]
    },
    {
      "path": "\\.[jt]sx?$",
      "content_requires": "\\b(safeParse|zod)\\b",
      "skills": [
        "react:validation"
      ]
    },
    {
      "path": "\\.[jt]sx?$",
      "content_requires": "\\b(cva|tailwind-merge)\\b",
      "skills": [
        "react:styling"
      ]
    },
    {
      "path": "\\.[jt]sx?$",
      "content_requires": "@radix-ui/|@/components/ui/",
      "skills": [
        "react:ui-components"
      ]
    }
  ]
}
