{
  "tier": "react",
  "stack": "TypeScript/React",
  "applies": "stack-present",
  "detect": {
    "any": [
      {
        "file": "tsconfig.json"
      },
      {
        "glob": "*.tsx"
      },
      {
        "glob": "*.ts"
      },
      {
        "glob": "*.jsx"
      },
      {
        "content": {
          "glob": "package.json",
          "pattern": "\"(react|react-dom|typescript)\"\\s*:"
        }
      },
      {
        "remote": "^tj\\-agents/react$"
      }
    ]
  }
}
